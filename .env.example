# =============================================================================
#  .env.example – file mẫu. KHÔNG sửa trực tiếp, hãy chạy:  ./scripts/init-env.sh
#  Script sẽ copy sang .env và tự sinh mật khẩu ngẫu nhiên (các giá trị CHANGE_ME).
#  File .env chứa bí mật => đã nằm trong .gitignore, không commit lên Git.
# =============================================================================

# ---- Chọn các file compose sẽ dùng (Linux/macOS dùng dấu ':' để ngăn cách) ----
# Chỉ phần lõi:          COMPOSE_FILE=docker-compose.yml
# + Bảo mật (HTTPS...):  COMPOSE_FILE=docker-compose.yml:docker-compose.security.yml
# Đầy đủ:                COMPOSE_FILE=docker-compose.yml:docker-compose.security.yml:docker-compose.monitoring.yml
COMPOSE_FILE=docker-compose.yml

# ---- Image Nextcloud (nên ghim phiên bản cụ thể sau khi cài, ví dụ nextcloud:31-apache) ----
NEXTCLOUD_IMAGE=nextcloud:apache

# ---- Truy cập web ----
NC_HTTP_PORT=8080
# 0.0.0.0 = mọi địa chỉ; đổi thành 127.0.0.1 khi đã bật HTTPS qua Caddy
NC_BIND_IP=0.0.0.0
# Danh sách tên miền/IP được phép truy cập (cách nhau bằng dấu cách).
# LƯU Ý: chỉ có tác dụng ở lần cài đặt đầu tiên. Về sau dùng: occ config:system:set trusted_domains
NEXTCLOUD_TRUSTED_DOMAINS="localhost"
# Mạng frontend cố định để khai báo TRUSTED_PROXIES. Đổi nếu trùng dải mạng của bạn.
FRONTEND_SUBNET=172.28.77.0/24

# ---- Tài khoản quản trị Nextcloud ----
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME

# ---- MariaDB ----
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=CHANGE_ME

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME

# ---- Backup ----
# Số ngày giữ lại bản sao lưu (backup.sh tự xóa bản cũ hơn)
BACKUP_KEEP_DAYS=7

# =============================================================================
#  NÂNG CAO – BẢO MẬT (docker-compose.security.yml)
# =============================================================================
# Tên miền hoặc IP mà Caddy phục vụ HTTPS (chứng chỉ tự ký nội bộ, "tls internal").
# Truy cập từ máy khác: đặt thành IP của máy chủ/VM và thêm vào trusted_domains bằng occ.
NC_DOMAIN=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# =============================================================================
#  NÂNG CAO – GIÁM SÁT (docker-compose.monitoring.yml)
# =============================================================================
# 127.0.0.1 = chỉ truy cập được từ chính máy chủ (an toàn).
# Muốn xem từ máy khác: đổi thành 0.0.0.0 hoặc dùng SSH tunnel (ssh -L 3000:localhost:3000 ...)
MON_BIND_IP=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

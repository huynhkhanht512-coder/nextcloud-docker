{
  "uid": "nc-docker",
  "title": "Nextcloud stack - Docker containers",
  "tags": ["docker", "nextcloud"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Container đang chạy",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 4 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "count((time() - container_last_seen{name=~\"nc_.+\"}) < 60)", "legendFormat": "running" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Thời gian chạy liên tục (uptime) - tụt về 0 nghĩa là vừa restart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": null }, { "color": "green", "value": 120 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "expr": "time() - container_start_time_seconds{name=~\"nc_.+\"}", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU (% của 1 core) theo container",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"nc_.+\"}[1m])) * 100", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bộ nhớ (working set) theo container",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "container_memory_working_set_bytes{name=~\"nc_.+\"}", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Mạng nhận (RX) theo container",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"nc_.+\"}[1m]))", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Mạng gửi (TX) theo container",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"nc_.+\"}[1m]))", "legendFormat": "{{name}}" }
      ]
    }
  ]
}
